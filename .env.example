# ---- Server ----
PORT=8787
# Where deal/audit state is persisted (JSON file). Use a Render disk path in production.
DATA_FILE=./data/db.json

# ---- AI provider ----
# claude | gemini | heuristic. Empty = Claude if its key is set, else Gemini, else offline heuristic agents.
AI_PROVIDER=

# Google Gemini (free tier / credits via Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used automatically if the main model is out of free quota or overloaded
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- PayPal (Sandbox) ----
# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
# Leave both empty to run PayPal in MOCK mode (no network calls, simulated IDs).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Webhook ID from the PayPal dashboard (needed for signature verification of /api/webhooks/paypal)
PAYPAL_WEBHOOK_ID=
# Set to true ONLY for local testing with forged events; never in production.
PAYPAL_WEBHOOK_SKIP_VERIFY=false
